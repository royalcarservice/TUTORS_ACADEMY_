# Tutors Academy — Supabase (ruling P5-R1). Copy to .env.local (git-ignored). NEVER commit real values.
# Public pair: safe in the browser; every read is bounded by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Read exclusively by src/lib/supabase/service.ts. No NEXT_PUBLIC_ prefix, ever.
SUPABASE_SERVICE_ROLE_KEY=

# Tutor registration (Stripe-hosted Checkout; server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paste the actual owner-approved refund terms here, verbatim. Blank means checkout stays disabled.
TUTOR_REGISTRATION_REFUND_POLICY=
# Live charges require CONTEXT=production and an explicit true opt-in. Use sk_test_ keys in previews.
TUTOR_REGISTRATION_LIVE_PAYMENTS_ENABLED=false
