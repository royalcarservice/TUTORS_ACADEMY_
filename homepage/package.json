{
  "name": "tutors-academy-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tutors Academy \u2014 scroll-choreographed 3D homepage (React + TypeScript + Vite + Tailwind + R3F + GSAP ScrollTrigger)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b --noEmit false --emitDeclarationOnly false && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:ui:reduced": "node scripts/ui-smoke.mjs --reduced-motion",
    "test": "npm run typecheck && npm run smoke && npm run smoke:ui && npm run smoke:ui:reduced"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
